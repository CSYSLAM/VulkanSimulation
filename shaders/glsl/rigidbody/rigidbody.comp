#version 460
#extension GL_EXT_ray_query : require

const uint MAX_BALLS = 128;

layout (local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

struct Ball {
    vec4 position;   // xyz=位置, w=半径
    vec4 velocity;   // xyz=速度, w=质量
    vec4 color;      // rgb=颜色, a=不透明度
};

layout (binding = 0) buffer BallBuffer {
    Ball balls[];
};

layout (binding = 1) uniform UBO {
    vec3 boundaryMin;
    float deltaTime;
    vec3 boundaryMax;
    float gravity;
    float restitution;
} ubo;

layout(binding = 2) uniform accelerationStructureEXT topLevelAS;

shared vec4 sharedPredPos[MAX_BALLS];

void predictPosition(uint gid) {
    sharedPredPos[gid].xyz = balls[gid].position.xyz + balls[gid].velocity.xyz * ubo.deltaTime;
    sharedPredPos[gid].y  += ubo.gravity * ubo.deltaTime * ubo.deltaTime;
    sharedPredPos[gid].w = 0.0; // w分量无用，置0
}

void solveBallConstraint(uint a, uint b) {
    vec3 pa = sharedPredPos[a].xyz;
    vec3 pb = sharedPredPos[b].xyz;
    float ra = balls[a].position.w;
    float rb = balls[b].position.w;
    vec3 dir = pb - pa;
    float dist = length(dir);
    float minDist = ra + rb;
    if (dist < minDist && dist > 1e-6) {
        // 质量分配
        float m1 = balls[a].velocity.w;
        float m2 = balls[b].velocity.w;
        float w1 = 1.0 / m1;
        float w2 = 1.0 / m2;
        float wSum = w1 + w2;
        vec3 normal = dir / dist;
        float correction = (minDist - dist);
        sharedPredPos[a].xyz -= normal * correction * (w1 / wSum);
        sharedPredPos[b].xyz += normal * correction * (w2 / wSum);
    }
    sharedPredPos[a].xyz = vec3(-1.0, 0, 0);
    sharedPredPos[b].xyz = vec3(1.0, 0, 0);
}

void solveBallBVHConstraints(uint gid) {
    const int numDirections = 12; // 6轴+6主对角
    vec3 rayDirs[numDirections] = vec3[](
        vec3(1,0,0), vec3(-1,0,0),
        vec3(0,1,0), vec3(0,-1,0),
        vec3(0,0,1), vec3(0,0,-1),
        normalize(vec3(1,1,1)), normalize(vec3(-1,1,1)),
        normalize(vec3(1,-1,1)), normalize(vec3(1,1,-1)),
        normalize(vec3(-1,-1,1)), normalize(vec3(-1,1,-1))// 中心点
    );
    
    vec3 origin = sharedPredPos[gid].xyz; // 球心
    float radius = balls[gid].position.w;
    
    for (int rd = 0; rd < numDirections; ++rd) {
        vec3 dir = rayDirs[rd];

        rayQueryEXT rayQuery;
        rayQueryInitializeEXT(rayQuery, topLevelAS,
            gl_RayFlagsOpaqueEXT,
            0xFF,
            origin,
            radius * 0.1,
            dir,
            radius * 2.0
        );
        
        while(rayQueryProceedEXT(rayQuery)) {
            if(rayQueryGetIntersectionTypeEXT(rayQuery, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
                
                uint instanceId = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);
                if (instanceId != gid) {
                    solveBallConstraint(gid, instanceId);
                }
            }
        }
    }
}

// 球-边界约束
void solveBoundaryConstraint(uint gid) {
    vec3 minB = ubo.boundaryMin;
    vec3 maxB = ubo.boundaryMax;
    vec3 pp = sharedPredPos[gid].xyz;
    float r = balls[gid].position.w;
    // X轴
    if (pp.x - r < minB.x) sharedPredPos[gid].x = minB.x + r;
    if (pp.x + r > maxB.x) sharedPredPos[gid].x = maxB.x - r;
    // Y轴
    if (pp.y - r < minB.y) sharedPredPos[gid].y = minB.y + r;
    if (pp.y + r > maxB.y) sharedPredPos[gid].y = maxB.y - r;
    // Z轴
    if (pp.z - r < minB.z) sharedPredPos[gid].z = minB.z + r;
    if (pp.z + r > maxB.z) sharedPredPos[gid].z = maxB.z - r;
}

void updateVelocity(uint gid) {
    vec3 newPos = sharedPredPos[gid].xyz;
    vec3 oldPos = balls[gid].position.xyz;
    balls[gid].velocity.xyz = (newPos - oldPos) / ubo.deltaTime;
    balls[gid].velocity.xyz *= 0.999; // 空气阻尼
}

void updatePosition(uint gid) {
    balls[gid].position.xyz = sharedPredPos[gid].xyz;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= MAX_BALLS) return;

    predictPosition(gid);

    const int ITER = 6;
    barrier();

    // for (int k = 0; k < ITER; ++k) {
    //     for (uint j = 0; j < MAX_BALLS; ++j) {
    //         if (gid < j) {
    //             solveBallConstraint(gid, j);
    //         }
    //     }
    //     solveBoundaryConstraint(gid);
    //     barrier();
    // }

    for (int k = 0; k < ITER; ++k) {
        solveBallBVHConstraints(gid);
        solveBoundaryConstraint(gid);
        barrier();
    }

    updateVelocity(gid);
    updatePosition(gid);
}