#version 460
#extension GL_EXT_ray_query : require

struct Particle
{
    vec3 pos;
    vec3 vel;
    vec4 gradientPos;
    float radius;
    float mass;
    float restitution;
    float padding;
};

// Binding 0 : Position storage buffer
layout(std140, binding = 0) buffer Pos 
{
   Particle particles[ ];
};

// Acceleration structure for collision detection
layout(binding = 2) uniform accelerationStructureEXT topLevelAS;

layout (local_size_x = 256) in;

layout (binding = 1) uniform UBO 
{
    float deltaT;
    float gravity;
    float floorY;
    int particleCount;
    int maxCollisionsPerParticle;
} ubo;

// Ray query for collision detection
bool checkCollision(vec3 origin, vec3 direction, float maxDistance, out float hitDistance, out int hitParticleIndex) {
    rayQueryEXT rayQuery;
    uint rayFlags = gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT;
    
    rayQueryInitializeEXT(rayQuery, topLevelAS, rayFlags, 0xFF, origin, 0.0, direction, maxDistance);
    
    // Traverse the acceleration structure
    while(rayQueryProceedEXT(rayQuery)) {
        if (rayQueryGetIntersectionTypeEXT(rayQuery, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            // Get the instance ID which corresponds to our particle index
            uint instanceCustomIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, false);
            
            // Skip self-collision
            if (instanceCustomIndex != gl_GlobalInvocationID.x) {
                rayQueryConfirmIntersectionEXT(rayQuery);
            }
        }
    }
    
    if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        hitDistance = rayQueryGetIntersectionTEXT(rayQuery, true);
        hitParticleIndex = int(rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true));
        return true;
    }
    
    return false;
}

// Sphere-sphere collision response
void resolveCollision(uint index1, uint index2) {
    Particle p1 = particles[index1];
    Particle p2 = particles[index2];
    
    vec3 delta = p2.pos - p1.pos;
    float distance = length(delta);
    float minDist = p1.radius + p2.radius;
    
    // Check if particles are overlapping
    if (distance < minDist) {
        // Calculate collision normal
        vec3 normal = normalize(delta);
        
        // Calculate relative velocity
        vec3 relVel = p2.vel - p1.vel;
        
        // Calculate relative velocity along normal
        float velAlongNormal = dot(relVel, normal);
        
        // Do not resolve if particles are moving away from each other
        if (velAlongNormal > 0)
            return;
        
        // Calculate restitution (bounciness)
        float e = min(p1.restitution, p2.restitution);
        
        // Calculate impulse scalar
        float j = -(1.0 + e) * velAlongNormal;
        j /= 1.0/p1.mass + 1.0/p2.mass;
        
        // Apply impulse
        vec3 impulse = j * normal;
        particles[index1].vel -= impulse / p1.mass;
        particles[index2].vel += impulse / p2.mass;
        
        // Correct position to prevent sinking
        float correctionFactor = 0.2; // Penetration correction factor
        vec3 correction = normal * correctionFactor * (minDist - distance) / 2.0;
        particles[index1].pos -= correction;
        particles[index2].pos += correction;
    }
}

// Floor collision
void resolveFloorCollision(uint index) {
    Particle p = particles[index];
    if (p.pos.y - p.radius < ubo.floorY) {
        particles[index].pos.y = ubo.floorY + p.radius;
        particles[index].vel.y = -p.vel.y * p.restitution;
        
        // Apply some friction to horizontal movement
        particles[index].vel.x *= 0.95;
        particles[index].vel.z *= 0.95;
    }
}

void main() 
{
    // Current SSBO index
    uint index = gl_GlobalInvocationID.x;
    // Don't try to write beyond particle count
    if (index >= ubo.particleCount) 
        return;    

    // Read position and velocity
    vec3 vPos = particles[index].pos;
    vec3 vVel = particles[index].vel;
    
    // Apply gravity
    vVel.y -= ubo.gravity * ubo.deltaT;
    
    // Move by velocity
    vPos += vVel * ubo.deltaT;
    
    // Update position and velocity
    particles[index].pos = vPos;
    particles[index].vel = vVel;
    
    // Check and resolve floor collision
    resolveFloorCollision(index);
    
    // Check for collisions with other particles
    for (int i = 0; i < ubo.maxCollisionsPerParticle; i++) {
        float hitDistance;
        int hitParticleIndex;
        
        // Check in multiple directions to improve collision detection
        vec3 directions[6] = {
            vec3(1.0, 0.0, 0.0),
            vec3(-1.0, 0.0, 0.0),
            vec3(0.0, 1.0, 0.0),
            vec3(0.0, -1.0, 0.0),
            vec3(0.0, 0.0, 1.0),
            vec3(0.0, 0.0, -1.0)
        };
        
        for (int dir = 0; dir < 6; dir++) {
            if (checkCollision(vPos, directions[dir], particles[index].radius * 2.0, hitDistance, hitParticleIndex)) {
                resolveCollision(index, hitParticleIndex);
            }
        }
    }
    
    // Update gradient for visualization
    particles[index].gradientPos.x += 0.02 * ubo.deltaT;
    if (particles[index].gradientPos.x > 1.0)
        particles[index].gradientPos.x -= 1.0;
}
